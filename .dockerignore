# .dockerignore
#
# Include any files or directories that you don't want to be copied to
# your container here such as local build artifacts, temporary files,
# etc.
#
# .dockerignore Guide:
# https://docs.docker.com/go/build-context-dockerignore/

**/.DS_Store
**/__pycache__
**/.venv
**/.classpath
**/.dockerignore
**/.env
**/.env.*
**/.dev.vars*
**/.wrangler
**/.git
**/.gitignore
**/.project
**/.settings
**/.settings.json
**/.settings.json.example
**/.toolstarget
**/.vs
**/.vscode
**/*.*proj.user
**/*.dbmdl
**/*.jfm
**/bin
**/charts
**/docker-compose*
**/compose.y*ml
**/Dockerfile*
**/node_modules
**/npm-debug.log
**/obj
**/secrets.dev.yaml
**/values.dev.yaml
LICENSE
README.md
