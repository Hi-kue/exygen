{
	"$schema": "./node_modules/nx/schemas/nx-schema.json",
	"defaultBase": "main",
	"namedInputs": {
		"default": ["{projectRoot}/**/*", "sharedGlobals"],
		"production": [
			"default",
			"!{projectRoot}/**/*.spec.ts",
			"!{projectRoot}/**/*.spec.tsx",
			"!{projectRoot}/**/*.test.ts",
			"!{projectRoot}/**/*.test.tsx",
			"!{projectRoot}/tests/**/*"
		],
		"sharedGlobals": [
			"{workspaceRoot}/nx.json",
			"{workspaceRoot}/package.json",
			"{workspaceRoot}/pnpm-workspace.yaml",
			"{workspaceRoot}/tsconfig.base.json",
			"{workspaceRoot}/biome.json",
			"{workspaceRoot}/pyproject.toml"
		]
	},
	"targetDefaults": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["production", "^production"],
			"cache": true
		},
		"typecheck": {
			"dependsOn": ["^typecheck"],
			"inputs": ["default", "^production"],
			"cache": true
		},
		"lint": {
			"inputs": ["default"],
			"cache": true
		},
		"format": {
			"inputs": ["default"],
			"cache": true
		},
		"check": {
			"inputs": ["default"],
			"cache": true
		},
		"test": {
			"dependsOn": ["^build"],
			"inputs": ["default", "^production"],
			"cache": true
		},
		"dev": {
			"cache": false
		},
		"serve": {
			"cache": false,
			"continuous": true
		}
	}
}
