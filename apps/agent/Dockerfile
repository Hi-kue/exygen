# syntax=docker/dockerfile:1

# README
# *=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*
# This Dockerfile defines the structure for Exygen
# agents and steps to reproduce a suitable image for
# local, staging, and prod environments.
# 
# DO NOT EDIT THIS FILE UNLESS YOU KNOW WHAT YOU ARE
# DOING, OR ARE AN AGENT!
# 
# NOTE
# *=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*
# To build from the workspace root, type in the 
# following command below within your terminal
# or ask an agent to run:
#
# docker build -f apps/agent/Dockerfile -t exygen-agent .

ARG PYTHON_IMAGE=python:3.12-slim-bookworm
ARG UV_VERSION=0.9.27

FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

FROM ${PYTHON_IMAGE} AS base
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# NOTE: 
# These are Native libraries used by Docling, OpenCV, and
# the ONNX Runtime. This will be required to be able to
# run the agents document parsing and vision
# capabilities.
RUN apt-get update \
    && apt-get install --no-install-recommends -y libgl1 libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

FROM base AS builder
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never
WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY apps/agent/pyproject.toml apps/agent/pyproject.toml
COPY apps/api/pyproject.toml apps/api/pyproject.toml
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-workspace --package exygen-agent

COPY apps/agent/README.md apps/agent/README.md
COPY apps/agent/src apps/agent/src
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-editable --package exygen-agent

FROM base AS runtime
RUN groupadd --gid 10001 exygen \
    && useradd --uid 10001 --gid exygen --create-home exygen \
    && mkdir -p /data /home/exygen/.cache \
    && chown -R exygen:exygen /data /home/exygen
COPY --from=builder /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH" \
    HOME=/home/exygen \
    XDG_CACHE_HOME=/home/exygen/.cache
USER exygen
WORKDIR /data

# NOTE:
# This Dockerfile references a one-off CLI, not 
# any HTTP server. If there are no arguments passed
# then it runs the offline demo, otherwise pass --course
# and --permission to process a file from within your
# local machine.
# 
# Example: 'run /data/exam-11-07-2026 --course [course] --permission [persmission]'
ENTRYPOINT ["exygen-agent"]
