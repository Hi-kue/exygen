# General Env
APP_ENV="dev"
APP_NAME="exygen-agent"
APP_VERSION=latest
APP_LOG_LEVEL=INFO
APP_DEBUG=false
APP_DATETIME_FORMAT="%Y-%m-%d %H:%M:%S"

# Agent Env
AGENT_LLM_PROVIDER="openrouter"  # openrouter | mock
AGENT_OPENROUTER_API_KEY=""
AGENT_OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
AGENT_OPENROUTER_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"
AGENT_TEMPERATURE=0.7
AGENT_TIMEOUT_SECONDS=300  # reading a whole exam can take minutes on a free model
AGENT_CLASSIFIER_READING_MODE="auto"  # auto | whole_document | per_page
AGENT_CLASSIFIER_WHOLE_DOCUMENT_MAX_CHARS=200000
AGENT_VISION_MODEL="nvidia/nemotron-3.5-super-vl:free"  # must accept images
AGENT_VISION_TIMEOUT_SECONDS=120
AGENT_CLEF_BASE_URL="https://api.cloudflare.com/client/v4/accounts"
AGENT_CLEF_MODEL="clef"  # clef | clef-flash
AGENT_CLEF_TIMEOUT_SECONDS=30
AGENT_CLEF_MAX_RETRIES=2
AGENT_CLEF_MIN_QUESTIONS=1
AGENT_CLEF_MAX_QUESTIONS=64  # Cloudflare allows at most 64

# Cloudflare Env
CF_ACCOUNT_ID=""
CF_AUTH_TOKEN=""

# RAG / ChromaDB Env
# AGENT_RAG_CHROMA_PERSIST_DIR=./chroma_db
# AGENT_RAG_COLLECTION_NAME=documents
# AGENT_RAG_EMBEDDING_MODEL=text-embedding-004
# AGENT_RAG_EMBEDDING_DIMENSION=768
# AGENT_RAG_CHROMA_HOST=localhost
# AGENT_RAG_CHROMA_PORT=8195
# CHROMA_AUTH_TOKEN=""

# Langfuse Env
LANGFUSE_API_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_BASE_URL=""
LANGFUSE_IS_TELEMETRY_ENABLED=false

# Docling Env
DOCLING_MAX_FILE_SIZE_MB=25
DOCLING_MAX_PAGES=100
DOCLING_DOCUMENT_TIMEOUT_SECONDS=300
DOCLING_OCR_ENABLED=true
DOCLING_FORCE_FULL_PAGE_OCR=false
DOCLING_OCR_LANGUAGES='["en"]'
DOCLING_DO_CODE_ENRICHMENT=false
DOCLING_DO_FORMULA_ENRICHMENT=false
DOCLING_CAPTURE_FIGURES=true
DOCLING_FIGURE_IMAGES_SCALE=2.0
DOCLING_FIGURE_MIN_PIXELS=32
