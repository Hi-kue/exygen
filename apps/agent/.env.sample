# General Env
APP_ENV="dev"
APP_NAME="exygen-agent"
APP_VERSION=latest
APP_LOG_LEVEL=INFO
APP_DEBUG=false
APP_DATETIME_FORMAT="%Y-%m-%d %H:%M:%S"

# Agent Env
AGENT_LLM_PROVIDER="openrouter"  # openrouter | mock
AGENT_OPENROUTER_API_KEY=""
AGENT_OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
AGENT_OPENROUTER_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"
AGENT_TEMPERATURE=0.7
AGENT_TIMEOUT_SECONDS=60

# RAG / ChromaDB Env
# AGENT_RAG_CHROMA_PERSIST_DIR=./chroma_db
# AGENT_RAG_COLLECTION_NAME=documents
# AGENT_RAG_EMBEDDING_MODEL=text-embedding-004
# AGENT_RAG_EMBEDDING_DIMENSION=768
# AGENT_RAG_CHROMA_HOST=localhost
# AGENT_RAG_CHROMA_PORT=8195
# CHROMA_AUTH_TOKEN=""

# Langfuse Env
LANGFUSE_API_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_BASE_URL=""
LANGFUSE_IS_TELEMETRY_ENABLED=false
